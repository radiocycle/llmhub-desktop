# Maintainer: radiocycle <https://github.com/radiocycle>
pkgname=llmhub
pkgver=1.0.0
pkgrel=1
pkgdesc="LLMHub Desktop - LLM client with auto-rotation, failover, custom endpoints, and reasoning support"
arch=('x86_64')
url="https://github.com/radiocycle/llmhub-desktop"
license=('Apache-2.0')
depends=('java-runtime>=17' 'gtk3')
makedepends=('java-environment=17' 'git')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/radiocycle/llmhub-desktop/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "${srcdir}/${pkgname}-desktop-${pkgver}"
    export GRADLE_USER_HOME="${srcdir}/.gradle"
    ./gradlew createDistributable --no-daemon
}

package() {
    cd "${srcdir}/${pkgname}-desktop-${pkgver}"

    install -dm755 "${pkgdir}/opt/llmhub"
    cp -r build/compose/binaries/main/app/llmhub/* "${pkgdir}/opt/llmhub/"
    chmod +x "${pkgdir}/opt/llmhub/bin/llmhub"

    install -dm755 "${pkgdir}/usr/bin"
    install -m755 packaging/llmhub.sh "${pkgdir}/usr/bin/llmhub"

    install -Dm644 packaging/llmhub.desktop "${pkgdir}/usr/share/applications/llmhub.desktop"
    install -Dm644 src/main/resources/icon.png "${pkgdir}/usr/share/icons/hicolor/512x512/apps/llmhub.png"
}
